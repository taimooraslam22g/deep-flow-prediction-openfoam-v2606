FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Ground-effect case: same schemes as the original, except for the convection of
// nuTilda, which groundGen.py fills in (GRAD_NUTILDA, DIV_NUTILDA; --nutilda-scheme):
//   linearUpwind  : the original. With a realistic (low) incoming nuTilda it
//                   undershoots below zero at the edge of the boundary layer, and
//                   OpenFOAM clips nuTilda in almost every iteration.
//   cellLimited   : the same scheme with a limited gradient (default)
//   limitedLinear : a TVD scheme

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
    @GRAD_NUTILDA@
}

divSchemes
{
    default         none;
    div(phi,U)      bounded Gauss linearUpwind grad(U);
    div(phi,nuTilda) @DIV_NUTILDA@;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method meshWave;
}


