/*--------------------------------*- C++ -*----------------------------------*\
  Ground-effect case: kinematic pressure p/rho [m^2/s^2].
  Same as the original case, plus a solid ground (zero gradient, like the airfoil).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
    }
    exit
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
    }
    top
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
    }
    ground
    {
        type            zeroGradient;
    }
    aerofoil
    {
        type            zeroGradient;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

// ************************************************************************* //
