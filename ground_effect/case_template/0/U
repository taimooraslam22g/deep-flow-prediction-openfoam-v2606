/*--------------------------------*- C++ -*----------------------------------*\
  Ground-effect case: velocity [m/s].
  groundGen.py replaces the VEL_X placeholders with the air speed.
  The air always flows parallel to the ground (no y component). The angle of
  attack comes from rotating the airfoil instead.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (@VEL_X@ 0 0);

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue uniform (@VEL_X@ 0 0);
    }
    exit
    {
        type            freestream;
        freestreamValue uniform (@VEL_X@ 0 0);
    }
    top
    {
        type            freestream;
        freestreamValue uniform (@VEL_X@ 0 0);
    }
    ground
    {
        // Moving ground: seen from the car, the road moves backwards at the
        // same speed as the air, so it has no boundary layer of its own.
        type            fixedValue;
        value           uniform (@VEL_X@ 0 0);
    }
    aerofoil
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

// ************************************************************************* //
